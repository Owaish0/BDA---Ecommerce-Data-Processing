# Replace password before starting. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-local-password
GENERATOR_RATE=100
GENERATOR_SCENARIO=normal
SPARK_MASTER=spark://spark-master:7077
SPARK_SHUFFLE_PARTITIONS=4
MAX_OFFSETS_PER_TRIGGER=10000
WATERMARK=2 minutes
DEFAULT_SOURCE=synthetic
# Prepare data/rees46.sqlite, then use DEFAULT_SOURCE=real for a fresh real-data instance.

# Tune to available Docker resources; defaults fit the original smaller setup.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=2g
STREAM_TRIGGER=5 seconds
